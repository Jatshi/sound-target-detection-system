FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip libsndfile1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /app/requirements.txt
RUN pip3 install --no-cache-dir -r requirements.txt && pip3 install --no-cache-dir onnxruntime-gpu
COPY . /app
ENV PYTHONPATH=/app/src
ENV SOUNDDET_SERVICE_HOST=0.0.0.0
EXPOSE 8765
HEALTHCHECK CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health', timeout=2).read()"
CMD ["python3", "scripts/run_service.py", "--config", "configs/prod.yaml"]

